{
  "name": "openstall",
  "version": "0.1.0",
  "private": true,
  "description": "Make social-only sellers buyable by any AI shopping agent, paid through PayPal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:api": "npm run dev -w @openstall/api",
    "day1": "tsx --env-file-if-exists=.env scripts/day1/run.ts",
    "day1:capture": "tsx --env-file-if-exists=.env scripts/day1/capture.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
