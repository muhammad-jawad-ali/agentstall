# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=

# Set after registering the webhook URL (https://<render-app>/webhooks/paypal) on the sandbox app
PAYPAL_WEBHOOK_ID=

# Optional: a second sandbox BUSINESS account email, for the payee-routing check (#10)
PAYPAL_SECOND_MERCHANT_EMAIL=

# Optional: override the remote MCP endpoint
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/http

# Gemini API key from https://aistudio.google.com/apikey (free tier, no billing needed)
GEMINI_API_KEY=

PORT=8787
# Public web origin (the web app proxies checkout and MCP paths to the API)
PUBLIC_URL=http://localhost:3000
# Where stalls are saved (SQLite); defaults to ./data
DATA_DIR=

# Optional: real Instagram import (Meta app with Instagram API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
